# Copy this file to `.env.wandb` or `.env.wandb.local` and fill in your key.
# Do not commit the real secret file.
#
# Example:
#   cp .env.wandb.example .env.wandb
#   nano .env.wandb
#   bash launch_parallel_journal_experiments.sh /path/to/checkpoints

export WANDB_API_KEY="replace_with_your_real_wandb_api_key"
# Optional:
# export WANDB_PROJECT="fanet-mac-rl"
